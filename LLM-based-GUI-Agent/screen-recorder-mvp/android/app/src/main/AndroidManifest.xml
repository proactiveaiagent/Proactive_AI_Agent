<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenRecorderMVP">
        <activity
            android:name="com.screenrecorder.mvp.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenRecorderMVP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.screenrecorder.mvp.AutoFilledSurveyActivity"
            android:exported="false"
            android:theme="@style/Theme.ScreenRecorderMVP" />
        <activity
            android:name="com.screenrecorder.mvp.SurveyDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ScreenRecorderMVP" />
        <service
            android:name="com.screenrecorder.mvp.ScreenRecordService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
    </application>
</manifest>
