{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "XOOCITY Screen Recorder Design Tokens",
    "version": "1.0.0",
    "platforms": ["web", "android"]
  },
  "color": {
    "bg": {
      "canvas": "#0F1117",
      "surface": "#161B26",
      "surfaceElevated": "#1C2333",
      "overlay": "rgba(15, 17, 23, 0.72)"
    },
    "text": {
      "primary": "#F4F6FB",
      "secondary": "#A7B0C0",
      "muted": "#6B7280",
      "inverse": "#0F1117"
    },
    "accent": {
      "primary": "#5B8CFF",
      "primaryHover": "#7BA3FF",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171"
    },
    "border": {
      "subtle": "#2A3142",
      "strong": "#3D4659"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "mono": "ui-monospace, 'Cascadia Code', Consolas, monospace"
    },
    "fontSize": {
      "xs": 12,
      "sm": 13,
      "md": 15,
      "lg": 18,
      "xl": 22,
      "xxl": 28
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.45,
      "relaxed": 1.6
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "shadow": {
    "card": "0 8px 24px rgba(0, 0, 0, 0.35)",
    "floating": "0 12px 40px rgba(0, 0, 0, 0.45)"
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32
  },
  "layout": {
    "bottomNavHeight": 56,
    "contentMaxWidth": 960,
    "headerHeight": 52
  },
  "navigation": {
    "primaryTabs": ["recording", "earnings", "data", "settings"],
    "labels": {
      "recording": "录制",
      "earnings": "收益",
      "data": "数据",
      "settings": "设置"
    }
  }
}
